{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cidadao",
  "description": "Contrato de resposta da API de cidadaos (suporta dados de acessibilidade para inclusao e diversidade).",
  "type": "object",
  "required": ["id", "nome", "cpf", "necessidadeAcessibilidade"],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "cpf": {
      "type": "string",
      "pattern": "^[0-9]{11}$"
    },
    "necessidadeAcessibilidade": {
      "type": "boolean"
    },
    "tipoAcessibilidade": {
      "type": ["string", "null"],
      "enum": ["VISUAL", "AUDITIVA", "MOTORA", "INTELECTUAL", "NENHUMA", null]
    }
  },
  "additionalProperties": false
}
